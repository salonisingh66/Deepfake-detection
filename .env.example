# DeepShield AI - Environment Configuration Example

# Application Settings
APP_NAME=DeepShield AI
APP_ENV=development
LOG_LEVEL=INFO

# Model Configuration
# Available model backends: vit_deepfake (genuine pretrained HuggingFace model), efficientnet_b0 (baseline), mesonet (baseline)
MODEL_NAME=dima806/deepfake_vs_real_image_detection
MODEL_BACKEND=vit_deepfake
CHECKPOINT_DIR=models/checkpoints
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.50

# Processing Limits (Optimized for 12GB RAM, CPU-only)
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=100
MAX_IMAGE_DIMENSION=4096
DEFAULT_VIDEO_FRAME_SAMPLE_INTERVAL=10
MAX_VIDEO_FRAMES_TO_SAMPLE=60
INFERENCE_BATCH_SIZE=8

# Database
DATABASE_PATH=data/deepshield_history.db

# API
API_HOST=127.0.0.1
API_PORT=8000
