# DeepShield AI - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
venv/
env/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Local model weights / Large binaries (exclude heavy checkpoints from git)
models/checkpoints/*.bin
models/checkpoints/*.pt
models/checkpoints/*.pth
models/checkpoints/*.safetensors
models/checkpoints/*.onnx

# Data & media uploads / Temp files
data/uploads/
data/temp/
reports/generated/*.pdf
reports/*.pdf
*.log
data/evaluation/*.csv


# SQLite databases
data/*.db
*.sqlite3
*.db

# Streamlit
.streamlit/
